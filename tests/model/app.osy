// Everything this app writes about inviting: its roles, who may invite, how its roles read, and what a customer
// company's own admin may do.
using Osysharp.Identity;
using Osysharp.UserAccounts;
using Osysharp.Organizations;
using Osysharp.Invitations;

[Role] enum AppRole { Authenticator, Member, Agent, Admin, CustomerAdmin }

policy IsAdmin => RoleGrant.Any(g => g.Member == user && g.Role == AppRole.Admin);
policy MayInvite => IsAdmin;
policy ManagesOrganizations => IsAdmin;

app.Accounts = new AccountsSetup {
  AppName = "Invite Desk", SignupOpen = false, SecondFactor = new AdminsUseCodes(),
};

app.Roles = new RolesSetup { Offered = [
  new RoleChoice { Role = AppRole.Agent, Label = "Agent", Description = "Works the desk." },
  new RoleChoice { Role = AppRole.Admin, Label = "Admin", Description = "Runs the desk." },
  new RoleChoice { Role = AppRole.CustomerAdmin, Label = "Company admin", Description = "Looks after their company's people.",
                   HeldIn = RoleScope.Organization },
] };

/// Admins must use two-step sign-in.
public class AdminsUseCodes : SecondFactorPolicy {
  public override bool Required(User account) { return RoleGrant.Any(g => g.Member == account && g.Role == AppRole.Admin); }
}

/// A customer company — its own admin invites its people into it, and nowhere else.
///
/// The app's own read rules on its own kind of organisation bind every reader — the invitation's run too, which writes
/// as its own actor (`InvitationRun`) and must read the company it makes a membership in. So the app says so, by name:
/// a subtype the app declares is the app's to open, and no kit can open it for itself.
entity Company : Organization {
  security {
    allow read, create, update when IsAdmin;
    allow read when IsOrganizationMember where IsMemberOf(this);
    allow read when user == Actor.Of<InvitationRun>();
  }
}

// The app's own rule on who gives its Admin role. It binds an invitation's grant as it binds any write, and is asked
// about the person who SENT the invitation, as they stand when it is accepted (tests/inviter-rules.test.osy).
partial entity RoleGrant {
  security { deny create when !IsAdmin where Role == AppRole.Admin message "Only an admin makes an admin."; }
}

partial entity Invitation {
  security { allow read, create, update when IsAuthenticated where Organization != null && HoldsRoleIn(Organization, AppRole.CustomerAdmin); }
}

/// What the desk does when an invitation is accepted (tests/inviter-rules.test.osy): an invitation into a company whose
/// SENDER asked for it seats the person there as an agent too, through the Organizations kit. The override runs as the
/// system with this app's own denies off, so it decides only from what the sender fixed: a `SeatAsAgent` row the platform
/// stamped as made by the invitation's `SentBy`. A row anyone else made, or an edited `Note`, seats nobody. It also notes
/// whom it acts for (`AcceptanceSeen`).
public class DeskInvitationEvents : InvitationEvents {
  public override void Accepted(Invitation invitation, Principal person) {
    new AcceptanceSeen { Invitation = invitation, ActedFor = Security.AskedById };
    var sender = invitation.SentBy;
    var invitationId = invitation.Id;
    if (invitation.Organization != null && sender != null
        && SeatAsAgent.Any(s => s.Invitation.Id == invitationId && s.AskedBy == sender)) {
      GrantIn(invitation.Organization!, person, AppRole.Agent);
    }
  }
}

/// The sender's ask that the person they invite is seated as an agent too. Whoever made it is stamped by the platform
/// (`AskedBy`), never written, so the override can tell the sender's ask from anybody else's.
public entity SeatAsAgent {
  [Required, Immutable] Invitation Invitation;
  [CreatedBy] Guid? AskedBy;
  security { allow read, create when IsAdmin; }
}

/// Whom the desk's `Accepted` acted for, as the platform says: the person the row is made for (`[CreatedFor]`, stamped by
/// the platform) and the person `Security.AskedById` read there. Only the app's code at the kit's seam makes one.
public entity AcceptanceSeen {
  [Required, Immutable] Invitation Invitation;
  [CreatedFor] Guid? MadeFor;
  Guid? ActedFor;
  security { allow read when IsAdmin; }
}

app.Invitations = new InvitationsSetup { Events = new DeskInvitationEvents() };
