namespace Osysharp.Invitations;

using Osysharp.Identity;
using Osysharp.UserAccounts;
using Osysharp.Organizations;
using Osysharp.Mail;
using Osysharp.Workflow;

// ── who may invite — the app's to say ────────────────────────────────────────────────────────────────────────────────

/// Who invites people into the app, and revokes and resends invitations. Only the app knows, so the app DEFINES it (a
/// missing definition is a compile error naming it):
///   `policy MayInvite => RoleGrant.Any(g => g.Member == user && g.Role == AppRole.Admin);`
/// More — an organisation's own admin inviting into that organisation — is an ordinary grant on `Invitation`:
///   `partial entity Invitation { security { allow create where Organization != null && HoldsRoleIn(Organization, AppRole.CompanyAdmin); } }`
policy MayInvite;

// ⚠ Appended, never inserted: an enum is stored by position.
/// Where an invitation stands — moved by its run alone.
public enum InvitationStatus {
  /// Sent, waiting for an answer.
  [Label("Waiting")] Pending,
  [Label("Accepted")] Accepted,
  [Label("Revoked")] Revoked,
  /// Its time ran out unanswered.
  [Label("Expired")] Expired,
}

/// An invitation for one ADDRESS to join the app — with `Role`, and within `Organization` when it names one. Everything
/// it will grant is fixed when it is sent: nobody edits an invitation into a bigger one, and accepting cannot choose.
///
/// SECURITY-INVARIANT(invitations-answered-only-by-the-invited-address): an invitation is accepted only by the address it
/// was sent to — by a NEWCOMER through the mailed link (whose token is single-use and stored only as a hash, and which
/// makes an account for that address and no other), or by an EXISTING account only through the app, signed in — every
/// step, the second factor included — with that address PROVEN. Holding the mailbox never accepts for an account
/// (a password reset would at least ask for its second factor), and having typed the address never accepts as it.
/// One exception, chosen by the inviter when they send it (`AnotherAddressAllowed`): a newcomer may make their account
/// for ANOTHER address — but only one PROVEN by a confirmation mailed to it (`AddressProof`), before the account is made.
/// Guarded by tests/accept.test.osy and tests/another-address.test.osy.
///
/// SECURITY-INVARIANT(invitations-grant-only-what-was-sent): what an invitation grants is fixed at send — its address,
/// role and organisation are never edited, it never carries the sign-in flow's `Authenticator` role, and the person it
/// names as the inviter is whoever sent it. Floors, so no grant the app writes loosens them. Guarded by
/// tests/invite.test.osy.
[Authority(Extensible)]
public entity Invitation {
  [CreatedAt] DateTime? CreatedAt;
  /// The address invited — normalised (`NormalisedEmail`), the only one that may answer.
  [Required("Say who to invite — an address."), MaxLength(255)] string Email;
  /// The app role the person will hold — or, with `Organization`, the role they will hold there. None: they join with
  /// no role (or as a plain member of the organisation).
  role? Role;
  /// The organisation they are invited into, if any.
  Organization? Organization;
  /// A line from the inviter, quoted in the mail.
  [MaxLength(1000)] string? Note;
  [Required] Principal InvitedBy;
  /// How long it stays open from when it was last sent.
  TimeSpan ValidFor = TimeSpan.FromDays(7);
  /// When to remind an invitee who has not answered, and how often after that (zero: once).
  TimeSpan RemindAfter = TimeSpan.FromDays(3);
  TimeSpan RemindEvery = TimeSpan.FromDays(2);
  DateTime? SentAt;
  int Sends = 0;
  int Reminders = 0;
  /// When it lapses, unanswered — from the last time it was sent.
  DateTime? ExpiresAt;
  InvitationStatus Status;
  Principal? AcceptedBy;
  DateTime? AcceptedAt;
  /// Who revoked it, or last resent it — written by the person doing it, as they do it (`RevokeInvitation`,
  /// `ResendInvitation`), which is what asks whether they may: the write needs the app's `update` grant.
  Principal? RevokedBy;
  Principal? LastSentBy;
  /// Whether the newcomer may make their account for ANOTHER address than the one invited — proven by a confirmation
  /// mailed to it before the account is made. Off unless the inviter says so; fixed at send.
  bool AnotherAddressAllowed = false;

  security {
    // The mailed link's key reads the invitation it was made for — the page shows the invited address from it, so the
    // newcomer never types it.
    allow read by InvitationKey;
    allow read, create, update when MayInvite;
    // The invitee sees what they are invited to — once they have proven they are its address.
    allow read when IsAuthenticated && user.EmailVerifiedAt != null where Email == user.Email;
    // `Role != null` first: an invitation with no role is unknown to `Role == …`, and an unknown deny applies.
    deny create where Role != null && Role == role.Authenticator;
    deny create where InvitedBy != user;
    // Fixed at send — what it grants, to whom, and from whom.
    deny update Email;
    deny update Role;
    deny update Organization;
    deny update InvitedBy;
    deny update ValidFor;
    deny update AnotherAddressAllowed;
    // Its run's record — moved by the run alone (which writes as the system), never by a person.
    deny update SentAt;
    deny update Sends;
    deny update Reminders;
    deny update ExpiresAt;
    deny update AcceptedBy;
    deny update AcceptedAt;
  }
}

// ── the run ──────────────────────────────────────────────────────────────────────────────────────────────────────────

/// What a newcomer's answer carries over the mailed link — the address they typed (it must be the invited one), the name
/// they gave, and their password's hash (never the password).
public class JoinAnswer {
  [ExternalName("email")] public string Email = "";
  [ExternalName("name")] public string Name = "";
  [ExternalName("passwordHash")] public string PasswordHash = "";
  /// For another address than the invited one: the `AddressProof` its confirmation mail carried.
  [ExternalName("proof")] public string Proof = "";
}

/// The key the mailed link carries beside its single-use token: it reads the invitation it was made for, so the page can
/// show the invited address (and whether another may be used) to a newcomer who is not signed in. It reads, and nothing
/// more — accepting still takes the token.
public grant InvitationKey for Invitation { Expires = TimeSpan.FromDays(400); }

// ⚠ Appended, never inserted.
public enum InvitationAddressState { [Label("Asked")] Asked, [Label("Mailed")] Mailed }

/// Another address a newcomer asked to join with, for an invitation that allows one (`AnotherAddressAllowed`). Its run
/// mails the address a confirmation link carrying an `AddressProof`; only that link makes an account for it.
public entity InvitationAddress {
  [CreatedAt] DateTime? CreatedAt;
  [Required] Invitation Invitation;
  /// The other address — normalised.
  [Required, MaxLength(255)] string Email;
  /// The invitation's single-use token the newcomer holds — carried on into the confirmation link, which needs it to
  /// accept. The holder of the invitation's key already has it.
  [Required, MaxLength(200)] string Token;
  InvitationAddressState State;

  security {
    allow read, create by InvitationKey where Invitation == InvitationKey.Row;
    allow read by AddressProof;
    deny update Invitation, Email, Token;
  }
}

/// The link mailed to another address: holding it proves the address received it.
public grant AddressProof for InvitationAddress { Expires = TimeSpan.FromDays(7); }

workflow InvitationAddressFlow {
  Tracks    = InvitationAddress.State;
  Autostart = true;
  Initial   = Asked;

  // On a clock due at once, not in `enter` — the mail would hold the commit that saved the row.
  state Asked {
    Expire { Within = TimeSpan.Zero; Accrues = false; }
    on Expire {
      MailAddressConfirmation(this.Item);
      goto Mailed;
    }
  }
  terminal success Mailed { }
}

workflow InvitationFlow {
  Tracks    = Invitation.Status;
  Autostart = true;
  Initial   = Pending;

  /// Accepted. Raised by the invitee in the app — signed in, with the invited address proven — or answered over the
  /// mailed link by a newcomer, which carries no principal at all (the link is the permission, and it can only make an
  /// account for the invited address).
  [Authorize(u => u.Email == this.Item.Email && u.EmailVerifiedAt != null)]
  event Accept(string? email, string? name, string? passwordHash, string? proof);
  event Revoke();
  event Resend();

  on Revoke { goto Revoked; }

  state Pending {
    // ⚑ CANDIDATES ARE THE INVITED ADDRESS, PROVEN — so the in-app door (and a work list showing it) is that person's
    //   alone. The mailed link answers this same slot with no principal; its handler makes an account for the invited
    //   address only, and refuses an address that already has one (that person signs in and accepts here instead).
    subscribe Accept() as Acceptance {
      Candidates = u => u.Email == this.Item.Email && u.EmailVerifiedAt != null;
      Finished {
        Within = this.Item.ValidFor;
        Accrues = false;
        Remind Chase(After = this.Item.RemindAfter, ThenEvery = this.Item.RemindEvery, Accrues = false) {
          this.Item.Reminders = this.Item.Reminders + 1;
          MailInvitation(this.Item, Acceptance.CallbackUrl(), true);
        }
        Unfinished { goto Expired; }
      }
    }

    // The mail goes out on a clock due at once, not in `enter`: an autostarted run's first step is part of the commit
    // that saved the invitation, and a send there would hold that commit (lint workflow-first-step-waits-on-a-slow-call).
    Expire { Within = TimeSpan.Zero; Accrues = false; }
    on Expire {
      var now = DateTime.UtcNow;
      this.Item.SentAt = now;
      this.Item.Sends = this.Item.Sends + 1;
      this.Item.ExpiresAt = now + this.Item.ValidFor;
      MailInvitation(this.Item, Acceptance.CallbackUrl(), false);
    }

    // Sent again: the state is entered afresh, so the old link dies with its slot, a new one is mailed, and the time it
    // stays open starts over.
    on Resend { goto Pending; }

    on Acceptance(string? email, string? name, string? passwordHash, string? proof) {
      var invitation = this.Item;
      Principal? who = actor;
      if (who == null) {
        // The mailed link — a newcomer. Only for the invited address — or, when the invitation allows it, another
        // address PROVEN by its confirmation mail — and only when it has no account yet.
        var address = email == null ? "" : NormalisedEmail(email);
        if (address == "" || (address != invitation.Email && !ProvesAddress(invitation, address, proof))) {
          throw new ValidationException("This invitation was sent to another address — it can make an account only for that one.");
        }
        if (Principal.Any(p => p.Email == address)) {
          throw new ValidationException("That address already has an account. Sign in, and accept the invitation there.");
        }
        if (passwordHash == null || passwordHash == "") {
          throw new ValidationException("Choose a password to make your account.");
        }
        who = NewInvitedAccount(invitation, address, name ?? "", passwordHash);
      }
      GrantWhatWasSent(invitation, who!);
      invitation.AcceptedBy = who;
      invitation.AcceptedAt = DateTime.UtcNow;
      goto Accepted;
    }
  }

  terminal success Accepted { }
  terminal cancel  Revoked  { Message = "invitation revoked"; }
  terminal error   Expired  { Message = "invitation expired"; }
}

/// The account a newcomer makes by accepting — the app's own kind (`AccountsSetup.Kinds`), for `address` (the invited
/// one, or another the invitation allows and a confirmation mail proved), with that address proven (the mail it came by
/// was opened) and the password they chose.
User NewInvitedAccount(Invitation invitation, string address, string name, string passwordHash) {
  var shown = name.Trim();
  var account = App.Setting<InvitationsSetup>().Accounts.New(invitation, address, shown);
  if (account.Email != address) {
    throw new ValidationException("The app's InvitationAccounts.New made an account for another address — it must use the one it was given.");
  }
  var now = DateTime.UtcNow;
  account.PasswordHash = passwordHash;
  account.PasswordChangedAt = now;
  account.EmailVerifiedAt = now;
  account.DisplayName = shown != "" ? shown : address.Substring(0, address.IndexOf("@"));
  return account;
}

/// Does `proof` — the text of an `AddressProof` — prove `address` for `invitation`, which allows another address? A
/// proof is the link mailed to that address for this invitation; anything else proves nothing.
bool ProvesAddress(Invitation invitation, string address, string? proof) {
  if (!invitation.AnotherAddressAllowed || proof == null || proof == "") { return false; }
  try {
    var p = AddressProof.From(proof);
    return p.Row.Invitation.Id == invitation.Id && p.Row.Email == address;
  }
  catch (Exception e) { return false; }
}

/// Mail `asked`'s address the link that proves it — the run's.
void MailAddressConfirmation(InvitationAddress asked) {
  var invitation = asked.Invitation;
  var link = AccountsLink($"/invite/{InvitationKey.For(invitation)}/{asked.Token}/as/{AddressProof.For(asked)}");
  var mail = App.Setting<InvitationsSetup>().Mails.AddressConfirmation(invitation, asked.Email, link);
  SendRendered(asked.Email, mail, $"invitation-address-{asked.Id}");
}

/// Grant what the invitation was sent with — the app role, or the organisation and the role held in it. Nothing else.
void GrantWhatWasSent(Invitation invitation, Principal who) {
  if (invitation.Organization != null) {
    var org = invitation.Organization!;
    Join(org, who, MembershipSource.Invitation);
    if (invitation.Role != null) { GrantIn(org, who, invitation.Role.Value); }
    return;
  }
  if (invitation.Role != null && !RoleGrant.Any(g => g.Member == who && g.Role == invitation.Role.Value)) {
    new RoleGrant { Member = who, Role = invitation.Role.Value };
    // The app is told in the acceptance's own write — an invited agent is put on the desk's queues as they arrive.
    App.Setting<RolesSetup>().Events.Granted(who, invitation.Role.Value);
  }
}
