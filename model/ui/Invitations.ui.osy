// The invitee's page, and the two pieces an app's people page uses: the form that sends one, and the list of the ones
// still waiting. Every colour, face and size is a theme token.
//
// ⚑ NO POLICY IS NAMED IN HERE. Who may invite is the app's `MayInvite`, which the kit cannot read in its own code (it
//   is the app's definition, bound when the app compiles) — so the app gates the PAGE these sit on, and passes
//   `canChange:` from its own policy. The rows and the functions are gated by the kit's rules either way: a control
//   offered to somebody who may not use it is refused, with the reason.

namespace Osysharp.Invitations;

using Osysharp.Identity;
using Osysharp.UserAccounts;
using Osysharp.Organizations;
using Osysharp.Ui;

/// An invitation as a page shows it.
public class InvitationView {
  public Guid Id;
  public string Email = "";
  /// What it brings you into — the organisation's name, or the app's.
  public string Into = "";
  public string From = "";
  /// The role it grants, by the name the app gives it — "" for none.
  public string RoleName = "";
  public DateTime? ExpiresAt;
  public int Sends = 0;
}

InvitationView ViewOf(Invitation i) {
  return new InvitationView {
    Id = i.Id, Email = i.Email, Into = InvitedInto(i), From = InviterName(i),
    RoleName = i.Role == null ? "" : RoleLabel(i.Role.Value), ExpiresAt = i.ExpiresAt, Sends = i.Sends,
  };
}

/// The waiting invitations the signed-in person may accept — to their own, PROVEN, address — as a page shows them.
[AllowAnonymous]
public List<InvitationView> MyInvitationViews() {
  List<InvitationView> all = [];
  foreach (var i in MyInvitations()) { all.Add(ViewOf(i)); }
  return all;
}

/// Accept the invitation `id` as the signed-in person (`AcceptInvitation`). Answers what it brought them into.
[AllowAnonymous]
public string AcceptInvitationById(Guid id) {
  var i = Invitation.Single(x => x.Id == id);
  var into = InvitedInto(i);
  AcceptInvitation(i);
  return into;
}

/// The invitations still waiting — app-wide, or into `into` — as a page shows them.
[SuppressWarning("cost-unbounded-read")]   // only the WAITING ones, and each expires — the invitations out now, not every one sent
public List<InvitationView> WaitingInvitations(Organization? into = null) {
  List<InvitationView> all = [];
  foreach (var i in Invitation.Where(x => x.Status == InvitationStatus.Pending && x.Organization == into)
                              .Include(x => x.InvitedBy).OrderByDescending(x => x.SentAt).ToList()) {
    all.Add(ViewOf(i));
  }
  return all;
}

public void RevokeInvitationById(Guid id) { RevokeInvitation(Invitation.Single(x => x.Id == id)); }
public void ResendInvitationById(Guid id) { ResendInvitation(Invitation.Single(x => x.Id == id)); }

/// What the invitee sees at the mailed link: signed out, a choice — make an account for the invited address (with the
/// link), or sign in to the one they have; signed in, the invitations waiting for their proven address, to accept.
[Composable]
public component InvitationAnswer(InvitationKey key, string token) {
  live var me = Session.CurrentUser;
  bool newcomer = true;
  // The invited address, read from the link's key on the server — shown, never typed.
  InvitedView? invited = null;
  bool otherAddress = false;
  string other = "";
  string asked = "";
  string email = "";
  string name = "";
  string password = "";
  string problem = "";
  bool joined = false;
  List<InvitationView> waiting = [];
  string accepted = "";

  on mount {
    invited = InvitationByKey(key);
    if (Session.CurrentUser != null) { waiting = MyInvitationViews(); }
  }

  action Join() {
    email = invited!.Email;
    problem = JoinByInvitation(token, email, name, password);
    if (problem == "") { joined = true; }
  }
  action UseAnother() { otherAddress = true; problem = ""; }
  action UseInvited() { otherAddress = false; problem = ""; }
  action AskForOther() {
    problem = AskToJoinAs(key, token, other);
    if (problem == "") { asked = other.Trim().ToLower(); }
  }
  action Accept(Guid id) {
    problem = "";
    try { accepted = AcceptInvitationById(id); waiting = MyInvitationViews(); }
    catch (Exception ex) { problem = ex.Message; }
  }
  action ShowNew() { newcomer = true; problem = ""; }
  action ShowExisting() { newcomer = false; problem = ""; }

  render {
    Stack(gap: 3) {
      if (me != null) {
        if (accepted != "") { Alert($"Welcome to {accepted}.", tone: Tone.Success); }
        if (me.EmailVerifiedAt == null) {
          Alert($"Confirm your address ({me.Email}) first — an invitation is accepted only by the address it was sent to, once it is proven.",
                tone: Tone.Default);
          TextLink("Go to your account", to: "/account");
        } else if (waiting.Count == 0) {
          if (accepted == "") {
            EmptyState("Nothing waiting for you", body: $"There is no open invitation for {me.Email}. It may have been accepted, withdrawn, or sent to another address.");
          }
        } else {
          Stack(gap: 2, role: UiRole.List, label: "Your invitations") {
            foreach (var i in waiting) {
              Row(gap: 3, align: Align.Center, role: UiRole.ListItem, label: i.Into, py: 2) {
                Stack(gap: 0, grow: 1, minW: "0") {
                  Text(i.Into, fontWeight: FontWeight.Semibold);
                  Text($"From {i.From}" + (i.RoleName != "" ? $" · as {i.RoleName}" : ""), color: Colors.TextMuted, fontSize: FontSize.Caption);
                }
                Button("Accept", onPress: () => Accept(i.Id), tone: Tone.Primary);
              }
            }
          }
        }
        if (problem != "") { Alert(problem, tone: Tone.Danger); }
      } else if (joined) {
        Alert("Your account is ready. Sign in — and you are in.", tone: Tone.Success);
        SignInForm(email: email, password: password);
      } else {
        Row(gap: 2, role: UiRole.Group, label: "How to answer") {
          Button("I'm new here", onPress: ShowNew, tone: newcomer ? Tone.Primary : Tone.Ghost);
          Button("I have an account", onPress: ShowExisting, tone: newcomer ? Tone.Ghost : Tone.Primary);
        }
        if (invited != null && !invited!.Open) {
          Alert("This invitation is no longer open — it may have been withdrawn, or it expired.", tone: Tone.Default);
        } else if (newcomer && asked != "") {
          Alert($"We sent a link to {asked}. Open it to confirm the address and make your account.", tone: Tone.Success);
        } else if (newcomer && otherAddress) {
          Text($"You were invited at {invited!.Email}. Join with another address — we mail it a link to confirm it is yours, and the account is made from that link.",
               color: Colors.TextMuted);
          Field("Your address", value: other, type: "email", placeholder: "name@company.com", onEnter: AskForOther);
          if (problem != "") { Alert(problem, tone: Tone.Danger); }
          Row(gap: 2, align: Align.Center) {
            Button("Send me a link", onPress: AskForOther, tone: Tone.Primary);
            Button($"Use {invited!.Email}", onPress: UseInvited, tone: Tone.Ghost);
          }
        } else if (newcomer && invited != null) {
          Text("Make your account — for the address this invitation was sent to.", color: Colors.TextMuted);
          Stack(gap: 0, role: UiRole.Group, label: "Invited address") {
            Text("Email", fontSize: FontSize.Caption, fontWeight: FontWeight.Medium);
            Text(invited!.Email, fontWeight: FontWeight.Semibold);
          }
          Field("Your name", value: name, placeholder: "How colleagues see you");
          Field("Password", value: password, type: "password", onEnter: Join, hint: "At least ten characters.");
          if (problem != "") { Alert(problem, tone: Tone.Danger); }
          Button("Join", onPress: Join, tone: Tone.Primary, size: Size.Lg);
          if (invited!.AnotherAddressAllowed) { Button("Join with another address", onPress: UseAnother, tone: Tone.Ghost, size: Size.Sm); }
        } else if (!newcomer) {
          Text("Sign in, and accept the invitation here.", color: Colors.TextMuted);
          SignInForm(then: $"/invite/{key}/" + token);
        }
      }
    }
  }
}

[Composable]
public component InvitationScreen(InvitationKey key, string token) {
  render { AccountsFrame("You are invited", sub: "Answer it with the address it was sent to.") { InvitationAnswer(key, token); } }
}

/// The page the mail links to — anybody may open it; the link (or a full sign-in) is what answers it.
[Route("/invite/{key}/{token}")] [Title("You are invited")] [AllowAnonymous] [Render(CSR)]
public component InvitationPage(InvitationKey key, string token) { render { InvitationScreen(key, token); } }

/// What a newcomer sees from the confirmation link mailed to another address: that address, proven, and the account to
/// make for it.
[Composable]
public component ProvenAddressAnswer(AddressProof proof, string token) {
  string address = "";
  string name = "";
  string password = "";
  string problem = "";
  bool joined = false;
  on mount { address = ProvenAddress(proof); }
  action Join() {
    problem = JoinByInvitationAs(proof, token, name, password);
    if (problem == "") { joined = true; }
  }
  render {
    Stack(gap: 3) {
      if (joined) {
        Alert("Your account is ready. Sign in — and you are in.", tone: Tone.Success);
        SignInForm(email: address, password: password);
      } else {
        Text("Your address is confirmed. Make your account for it.", color: Colors.TextMuted);
        Stack(gap: 0, role: UiRole.Group, label: "Confirmed address") {
          Text("Email", fontSize: FontSize.Caption, fontWeight: FontWeight.Medium);
          Text(address, fontWeight: FontWeight.Semibold);
        }
        Field("Your name", value: name, placeholder: "How colleagues see you");
        Field("Password", value: password, type: "password", onEnter: Join, hint: "At least ten characters.");
        if (problem != "") { Alert(problem, tone: Tone.Danger); }
        Button("Join", onPress: Join, tone: Tone.Primary, size: Size.Lg);
      }
    }
  }
}

/// The page the confirmation of another address links to.
[Route("/invite/{key}/{token}/as/{proof}")] [Title("You are invited")] [AllowAnonymous] [Render(CSR)]
public component InvitationAsPage(InvitationKey key, string token, AddressProof proof) {
  render { AccountsFrame("You are invited", sub: "Join with the address you confirmed.") { ProvenAddressAnswer(proof, token); } }
}

/// Send an invitation — an address, one of the roles the app offers (`app.Roles`), and an optional line. With `into`, to
/// that organisation, the role held there. `onSent` hears each one sent; `canSend` is the app's own answer to "may this
/// person invite?" (`canSend: MayInvite`) — the send is refused by the kit's rules either way.
[Composable]
public component InviteForm(Organization? into = null, Action onSent = null, bool canSend = true) {
  string email = "";
  string note = "";
  bool anotherAddress = false;
  RoleOption? chosen = null;
  string problem = "";
  string sent = "";
  List<RoleOption> roles = [];
  // Only the roles that may be held where this invitation leads — inside `into`, or across the app.
  on mount { roles = OfferedRoles(into == null ? RoleScope.App : RoleScope.Organization); }

  action Choose(RoleOption c) { chosen = c; }
  action Send() {
    problem = "";
    sent = "";
    try {
      Invite(email, role: chosen == null ? null : chosen.Role, organization: into, note: note, anotherAddress: anotherAddress);
      sent = $"Invitation sent to {email.Trim().ToLower()}.";
      email = "";
      note = "";
      anotherAddress = false;
      if (onSent != null) { onSent(); }
    }
    catch (Exception ex) { problem = ex.Message; }
  }

  render {
    Stack(gap: 3) {
      Field("Email", value: email, type: "email", placeholder: "name@company.com", onEnter: Send);
      if (roles.Count > 0) {
        Stack(gap: 1) {
          Text("Role", fontSize: FontSize.Caption, fontWeight: FontWeight.Medium);
          Row(gap: 2, wrap: Wrapping.Wrap, role: UiRole.Group, label: "Role") {
            foreach (var c in roles) {
              Button(c.Label, onPress: () => Choose(c), size: Size.Sm, tone: chosen != null && chosen.Label == c.Label ? Tone.Primary : Tone.Ghost);
            }
          }
          if (chosen != null && chosen.Description != "") { Text(chosen.Description, fontSize: FontSize.Caption, color: Colors.TextMuted); }
        }
      }
      Field("A note (optional)", value: note, placeholder: "Quoted in the invitation mail");
      Stack(gap: 1) {
        Switch("They may join with another address", value: anotherAddress);
        Text("Off: only the address above can make the account. On: they may choose another, which is confirmed by a mail to it first.",
             fontSize: FontSize.Caption, color: Colors.TextMuted);
      }
      if (problem != "") { Alert(problem, tone: Tone.Danger); }
      if (sent != "") { Alert(sent, tone: Tone.Success); }
      Button("Send invitation", onPress: Send, tone: Tone.Primary, disabled: !canSend);
    }
  }
}

/// The invitations still waiting — app-wide, or into `into` — with when each lapses, and resend and revoke (offered when
/// `canChange`, the app's own answer: `canChange: MayInvite`). Kept current as invitations are sent, answered or lapse.
[Composable]
public component InvitationList(Organization? into = null, bool canChange = true) {
  live var waiting = Invitation.Where(i => i.Status == InvitationStatus.Pending && i.Organization == into)
    .Include(i => i.InvitedBy).OrderByDescending(i => i.SentAt).ToList();
  List<RoleOption> roles = [];
  string problem = "";
  on mount { roles = OfferedRoles(); }

  /// Who sent it, as `InviterName` says it — computed here, on the client, from the row the list already holds.
  string SenderOf(Invitation i) {
    return PersonName(i.InvitedBy) != "" ? PersonName(i.InvitedBy) : (into != null ? "someone at " + into!.Name : "someone");
  }

  /// A role's name for people, from the roles the app offers — "" for none.
  string NameOf(Invitation i) {
    if (i.Role == null) { return ""; }
    foreach (var r in roles) { if (r.Role != null && r.Role.Value == i.Role.Value) { return r.Label; } }
    return "";
  }

  action Again(Invitation i) { problem = ""; try { ResendInvitation(i); } catch (Exception ex) { problem = ex.Message; } }
  action Withdraw(Invitation i) { problem = ""; try { RevokeInvitation(i); } catch (Exception ex) { problem = ex.Message; } }

  // While the invitations are read: one line's place, where "No invitations waiting." — a claim about them — would be.
  skeleton {
    Stack(gap: 0) { Box(py: 2) { Skeleton(shape: SkeletonShape.HalfLine); } }
  }
  render {
    Stack(gap: 0, role: (waiting.Count == 0) ? UiRole.Group : UiRole.List, label: "Waiting invitations") {
      if (waiting.Count == 0) { Text("No invitations waiting.", color: Colors.TextMuted, py: 2); }
      foreach (var i in waiting) {
        Row(gap: 3, align: Align.Center, py: 2, borderBW: 1, border: Colors.Border, role: UiRole.ListItem, label: i.Email) {
          Stack(gap: 0, grow: 1, minW: "0") {
            Text(i.Email, fontWeight: FontWeight.Medium);
            Text((NameOf(i) != "" ? NameOf(i) + " · " : "") + $"invited by {SenderOf(i)}"
                 + (i.ExpiresAt != null ? $" · lapses {i.ExpiresAt.Value.ToString("d MMM")}" : ""),
                 fontSize: FontSize.Caption, color: Colors.TextMuted);
          }
          if (canChange) {
            Button("Resend", onPress: () => Again(i), size: Size.Sm, tone: Tone.Ghost);
            Button("Revoke", onPress: () => Withdraw(i), size: Size.Sm, tone: Tone.Danger);
          }
        }
      }
      if (problem != "") { Alert(problem, tone: Tone.Danger); }
    }
  }
}
